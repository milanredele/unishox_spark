--
--  Differential test and benchmark. The C reference is compiled by run.sh
--  (clang) into build/libunishox2_ref.a.

with "../unishox_spark.gpr";

project Tests is

   for Source_Dirs use ("src");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("test_unishox.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwJ");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-L" & Project'Project_Dir & "build", "-lunishox2_ref");
   end Linker;

end Tests;
